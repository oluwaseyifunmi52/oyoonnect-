# OyoConnect Local Development Environment Variables

# Google Maps API Key
# Get your API key from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Enable "Maps JavaScript API", "Places API", and "Geocoding API"
# 4. Create credentials -> API Key
# 5. Restrict the key by HTTP referrers (your domain) for security
VITE_GOOGLE_MAPS_API_KEY=

# App configuration
VITE_APP_NAME=OyoConnect
VITE_APP_URL=http://localhost:5173

# Demo Mode - enables demo transactions without real API calls
VITE_ENABLE_DEMO_SERVICES=true

# Auth provider.
#   "dev"     (default) - DEVELOPMENT ONLY. Accounts and sessions live in
#             localStorage (src/services/auth/devAuthRepository.ts). The signup
#             -> login -> logout -> session-persist flow works without a backend.
#   "backend" (reserved) - NOT IMPLEMENTED yet. Requires the OyoConnect auth API
#             after which the authService swaps to the backend repository.
#             Do NOT set this until the backend exists.
VITE_AUTH_PROVIDER=dev

# Development Auth Bypass - ONLY for local development testing
# When true, allows access to protected routes without authentication
# Defaults to false for production safety
VITE_DISABLE_AUTH=false