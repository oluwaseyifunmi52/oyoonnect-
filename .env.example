# OyoConnect Environment Variables

# Google Maps API Key
# Get your API key from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Enable "Maps JavaScript API", "Places API", and "Geocoding API"
# 4. Create credentials -> API Key
# 5. Restrict the key by HTTP referrers (your domain) for security
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: App configuration
VITE_APP_NAME=OyoConnect
VITE_APP_URL=http://localhost:5173

# Demo Mode - enables demo transactions without real API calls
VITE_ENABLE_DEMO_SERVICES=true

# Auth provider. "dev" = development-only localStorage auth (default).
# Set to "backend" only when the OyoConnect auth API is available.
VITE_AUTH_PROVIDER=dev

# Development Auth Bypass - only for local testing (never in production)
VITE_DISABLE_AUTH=false